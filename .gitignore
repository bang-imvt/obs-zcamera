# =====================================================================
# obs-zcamera .gitignore
# Tracks: source, build config, vendored third-party source, LICENSE.
# Excludes: design docs, agent/assistant artifacts, build output, local deps.
# =====================================================================

# ---- Design / planning docs ----
# The whole doc folder stays out of the repo (bug lists, plans, spreadsheets).
/doc/

# ---- Build output (never commit) ----
/build/
/build*/
/release/
/out/
/dist/
/dist-mac/
/dist-local/
/dist-*/
/build-local/
/.build-overrides/
/CMakeCache.txt
/CMakeFiles/
/cmake/.CMakeBuildNumber

# ---- Local dependency fetches (obs-deps etc.) ----
/.deps/

# ---- Agent / assistant session artifacts ----
/.zcode/
/.agents/
/.agent/
/.trae/
/.workbuddy/
/agent*/
*zcode*
*.tmp
*.tmp.json

# ---- Editor / OS ----
.vscode/
.idea/
*.user
.DS_Store
Thumbs.db

# ---- Misc ----
*.lock.json
*.log
build_noffmpeg_*.txt
build_x64_*.txt
obsfe_*.log

# ---- Standalone test build output (tests\build_tests.ps1) ----
/tests/*.obj
/tests/*.exe
/tests/*.pdb
/tests/*.lib
/tests/*.exp
/tests/moc_*.cpp
/tests/*.dll

# ---- OBS integration test output (tests\obs_integration_test.ps1) ----
/tests/obs_out/

# ---- AI overlay test output (tests\obs_ai_overlay_test.ps1) ----
/tests/on.bmp
/tests/off.bmp
/tests/mix.bmp
/tests/result.json
/tests/pos_on.bmp
/tests/pos_off.bmp
/tests/position.json
# ... and the PNG previews of those frames kept alongside them
/tests/ai_overlay_on.png
/tests/ai_overlay_off.png

# ---- Dock screenshots (visual check of the framing tab) ----
/tests/framing_tab_idle.png
/tests/framing_tab_detecting.png
# ... and the camera web-UI reference shots / box captures kept during that work
/tests/web_*.png
/tests/ai_overlay_box.png
